# Adres projektu i klucz publiczny (publishable) z Supabase: Project Settings -> API Keys.
# Tajnych kluczy (service_role) tu nie potrzeba: backend działa z uprawnieniami zalogowanego zawodnika.
SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Adresy, z których strona może wywoływać API (oddzielone przecinkami).
CORS_ORIGINS=http://localhost:5173